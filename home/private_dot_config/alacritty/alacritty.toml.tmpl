[env]
TERM = "xterm-256color"

[window]
padding.x = 10
padding.y = 10
opacity = 0.7
blur = true
decorations = "{{ if eq .chezmoi.os "darwin" }}Buttonless{{ else }}None{{ end }}"
{{ if eq .chezmoi.os "darwin" -}}
option_as_alt = "Both"
{{ end }}

[font]
normal.family = "MesloLGS Nerd Font Mono"
size = 12

# Coolnight palette mirrored from the current setup; original theme by Josean Martinez.
[colors.primary]
background = "#011423"
foreground = "#CBE0F0"

[colors.cursor]
text = "#011423"
cursor = "#47FF9C"

[colors.normal]
black = "#214969"
red = "#E52E2E"
green = "#44FFB1"
yellow = "#FFE073"
blue = "#0FC5ED"
magenta = "#a277ff"
cyan = "#24EAF7"
white = "#24EAF7"

[colors.bright]
black = "#214969"
red = "#E52E2E"
green = "#44FFB1"
yellow = "#FFE073"
blue = "#A277FF"
magenta = "#a277ff"
cyan = "#24EAF7"
white = "#24EAF7"
